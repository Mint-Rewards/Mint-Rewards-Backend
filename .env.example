# Environment template for Mint Rewards Backend.
#
# lib/env.ts parses and validates every key below at module load and throws
# ONE error naming every missing or malformed value — that error tells you to
# read this file, which is why it now exists (issue #146 item 3).
#
# Copy to .env and fill in. No value here is real; the placeholders are
# syntactically valid so you can see the shape each key expects.
#
#   cp .env.example .env

# --- Environment ------------------------------------------------------------

# Exactly "development" or "production". Decides mail routing, which MongoDB
# URI is used, and whether DEV_MAIL_REDIRECT_TO is required or forbidden.
APP_ENV=development

# --- Database ---------------------------------------------------------------

# Production connection string. In development this is only used when
# MONGODB_URI_TEST is unset — see resolveMongoUriKey in lib/envShared.ts.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/mint_rewards

# Isolated test database. Required by jest.setup.js, which refuses to run
# without it rather than risk pointing a suite at production. When set, a
# development boot prefers it over MONGODB_URI.
MONGODB_URI_TEST=mongodb+srv://user:password@cluster.example.mongodb.net/mint_rewards_test

# Postgres target for the one-time MongoDB -> Postgres migration
# (scripts/migrate-mongo-to-postgres.mjs, npm run migrate:pg:test). Only
# used by that script — nothing else in this app reads it. Must point at a
# database with "test" in the name; the script refuses to run otherwise.
POSTGRES_URL_TEST=postgres://user:password@localhost:5432/mint_rewards_test

# --- Secrets ----------------------------------------------------------------
# Each must be at least 16 characters; lib/env.ts treats anything shorter as
# malformed rather than merely present.

# Consumer-app JWT signing key.
JWT_SECRET=replace-with-a-long-random-string
# Optional. Defaults to "7d" when unset.
JWT_EXPIRES_IN=7d

# BrandHub session signing key. Separate from JWT_SECRET by design — see
# lib/brandJwt.ts.
BRANDHUB_JWT_SECRET=replace-with-a-different-long-random-string

# Global admin session signing key.
ADMIN_JWT_SECRET=replace-with-a-third-long-random-string

# HMAC pepper for stored OTP hashes. Without a real value the hashes are
# trivially reversible.
OTP_PEPPER=replace-with-a-long-random-string

# --- Global admin login -----------------------------------------------------

ADMIN_EMAIL=admin@example.com

# bcrypt hash ($2a$ / $2b$ / $2y$). Next's env loader performs shell-style
# $VAR expansion on .env values, so the dollar signs MUST be backslash-escaped
# here or the hash is eaten; lib/env.ts unescapes them back.
ADMIN_PASSWORD_HASH=\$2b\$10\$CwTycUXWue0Thq9StjUM0uJ8.PjMDCLPu2H8dQmDCkPGYr8SoQO0O

# --- Identity providers -----------------------------------------------------

GOOGLE_IOS_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.example.mintrewards

# --- Email ------------------------------------------------------------------

RESEND_API_KEY=re_example_key
EMAIL_FROM="Mint Rewards" <noreply@verify.example.com>

# Non-production mail sink. REQUIRED whenever APP_ENV is not "production", and
# REJECTED outright when it is: every outbound message is rewritten to this
# address by resolveRecipient in emailServices/emailFunction.ts, so a dev
# deployment can never email a real user.
DEV_MAIL_REDIRECT_TO=sink@example.com

# Public origin of this backend. Used to build absolute links that land in
# email — today, the unsubscribe link in the referral template. Optional;
# defaults to the production deployment, so an unset value still produces a
# working link rather than one pointing at localhost.
# PUBLIC_BASE_URL=https://mint-rewards-backend.vercel.app/

# Signing secret for the Resend webhook (Svix, "whsec_..."), issued when you
# register <PUBLIC_BASE_URL>/api/webhooks/resend in the Resend dashboard.
# Optional so that an existing deployment does not fail to boot before the
# webhook exists — but the route rejects every delivery until it is set, since
# an unsigned suppression endpoint lets anyone suppress any address.
# RESEND_WEBHOOK_SECRET=whsec_example

# Physical mailing address shown in email footers, required by anti-spam law in
# most jurisdictions this sends into. Until it is set, the footer renders a
# visible "[TODO: postal address]" placeholder rather than silently omitting it.
# EMAIL_POSTAL_ADDRESS=Mint Rewards, 1 Example Street, Cape Town 8001, South Africa

# Optional. Absolute https URL of a UA-sniffing redirect that forwards to the
# right app store; used by the referral email. Unset is the expected state
# today — the template then offers both stores side by side.
# APP_DOWNLOAD_URL=https://mintrewards.app/download

# --- Storage ----------------------------------------------------------------

BLOB_PUBLIC_READ_WRITE_TOKEN=vercel_blob_rw_example_token

# --- CORS -------------------------------------------------------------------

# Comma-separated exact origins: scheme and host only, no trailing path.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Mobile force-update gate (all optional) --------------------------------
# Served by /api/app-config. Every key defaults to "gates nothing" — an unset
# or typo'd value must never hard-block installed apps in the wild, because
# the blocked app is the thing that would have to fetch the fix.

# MIN_SUPPORTED_APP_VERSION=0.0.0
# MIN_SUPPORTED_BUILD_IOS=0
# MIN_SUPPORTED_BUILD_ANDROID=0
# IOS_STORE_URL=https://apps.apple.com/app/id0000000000
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.mintrewards
# FORCE_OTA_UPDATE=false

# --- Location-capture gate (all optional) -----------------------------------
# Also served by /api/app-config. The resolution order (build-forced
# escalation, dismissal counting, etc.) is CLIENT logic — the server only
# serves these values.

# One of "hard" | "soft" | "off". Unset (and the deployed default) is "soft".
# "soft" MUST remain the deployed default until 2.1.11 store adoption is high
# enough to justify switching to "hard" — an invalid value fails the server
# to boot rather than silently falling back, since a typo here should never
# ship as a silent no-op.
# LOCATION_GATE_MODE=soft

# "true" or "false". Defaults to false (gate applies everywhere, not just
# activated cities).
# LOCATION_GATE_ACTIVATED_CITIES_ONLY=false

# Positive integer. Defaults to 3.
# LOCATION_GATE_MAX_DISMISSALS=3

# Optional non-negative integer build numbers. Unset means null — "no
# minimum configured for this platform" — not 0.
# LOCATION_GATE_MIN_BUILD_IOS=0
# LOCATION_GATE_MIN_BUILD_ANDROID=0

# --- Profile-completion bonus (all optional) --------------------------------
# Pays PROFILE_BONUS_POINTS to a user who finishes their profile within
# PROFILE_BONUS_WINDOW_HOURS of their FIRST app open, provided "now" is inside
# the campaign window. Additive to the 100 points signup already grants.
#
# Ships dark: unset means enabled=false and nothing is ever paid, whatever the
# other four values say. Turning the campaign on, off, or re-dating it is an
# env change only — no app release.

# "true" or "false". Defaults to false.
# PROFILE_BONUS_ENABLED=false

# Positive integer. Defaults to 100. Recorded per-user in profileBonusPoints at
# payout time, so changing it mid-campaign never rewrites what anyone was paid.
# PROFILE_BONUS_POINTS=100

# Positive integer hours. Defaults to 24. This is the PER-USER window, measured
# from that user's own first app open — not a wall-clock window shared by
# everyone, which is what the campaign dates below are for.
# PROFILE_BONUS_WINDOW_HOURS=24

# ISO-8601 datetimes bounding the campaign as a whole. Full timestamps, NOT the
# "YYYY-MM-DD" strings used for campaign/deal dates elsewhere: this window is
# measured in hours, so it needs an unambiguous instant on each end and does not
# go through lib/campaignDates.ts. Unset means unbounded on that end.
# PROFILE_BONUS_CAMPAIGN_START=2026-09-01T00:00:00Z
# PROFILE_BONUS_CAMPAIGN_END=2026-09-30T23:59:59Z

# --- Reverse geocoding (optional) -------------------------------------------
# Used by POST /api/location/reverse-geocode (P1.1). Optional: unset means the
# route answers { resolved: false } for every request without ever fetching
# LocationIQ or writing the permanent geocodeCache collection. Never returned
# in any response body.
# LOCATIONIQ_API_KEY=pk.example
