// Proposed NORMALIZED Postgres target schema for the eventual production
// Mongo -> Postgres migration. This is a design draft, not tooling output —
// unlike scripts/migrate-mongo-to-postgres.dbml (a mechanical, table-per-
// collection dump generated by the vendored rehearsal script for
// mint_rewards_test), every table here was deliberately reshaped by hand
// against lib/models.ts and docs/VOCABULARY.md. Paste into
// https://dbdiagram.io to render.
//
// Scope: structural normalization only (jsonb "dump" columns -> real
// tables/columns). Deliberately NOT included, see accompanying analysis:
//   - moving campaigns' discount data onto deals (VOCABULARY.md flags
//     `campaigns` as Discount-shaped data wearing a recycling-programme
//     name — a domain decision, not a storage one)
//   - a `deal_type` discriminator on deals (no second concrete deal type
//     exists yet to design against)
//   - rewiring users.structured_address to FK into cities/towns by id
//     instead of matching by display name (an existing, documented
//     invariant: "the registry has no synthetic ids — its keys ARE the
//     display names")
//   - retyping text-typed dates/lat-lng/percentages inherited from
//     Mongoose (needs a data audit first; some are intentionally string
//     during an in-progress dual-write, e.g. users.latitude/longitude)
//
// Table order matches lib/models.ts collection dependency order: a table
// with a foreign key comes after the table(s) it references.

Project mint_rewards_normalized {
  database_type: 'PostgreSQL'
  Note: '''
    Proposed normalized migration target for mint-rewards (MongoDB ->
    Postgres). Excludes the Log collection (high-volume, TTL, append-only —
    not migrated, same as the rehearsal schema).
  '''
}

Enum org_plan {
  starter
  growth
  enterprise
}

Enum brand_status {
  PENDING
  APPROVED
  REJECTED
}

Enum campaign_status {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

Enum collection_status {
  PENDING
  COMPLETED
}

Enum deal_status {
  pending
  active
  rejected
  inactive
  expired
}

Enum module_subscription_status {
  active
  trial
  expired
  cancelled
}

Enum location_source {
  map_pin
  area_centroid
  city_centroid
  legacy_string
  collector_verified
}

Enum location_precision {
  building
  block
  area
  city
  unknown
}

Enum location_verification_status {
  unverified
  auto_verified
  user_corrected
  mismatch
  unresolved
}

Enum snapshot_source {
  creation
  migrated
}

Enum otp_purpose {
  password_reset
  email_verification
}

Table organizations {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  plan org_plan [not null, default: 'starter']
  created_at timestamptz
  updated_at timestamptz

  Note: 'Mongo collection: organizations. module_subscriptions normalized into organization_module_subscriptions.'
}

Table organization_module_subscriptions {
  id integer [pk, increment]
  org_id text [not null]
  module text [not null]
  status module_subscription_status [not null]
  activated_at timestamptz [not null]
  expires_at timestamptz

  Note: 'Was organizations.moduleSubscriptions[]. One row per subscribed module.'

  indexes {
    (org_id, module) [unique]
  }
}

Table brandthemes {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  logo text [not null]
  background_color text [not null]
  accent_color text [not null]
  status text [not null]

  Note: 'Mongo collection: brandthemes (unchanged — already flat).'
}

Table locations {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  province text [not null, unique]

  Note: '''
    Mongo collection: locations (province level). cities/towns normalized
    out of the nested `cities` jsonb into their own tables below.
  '''
}

Table cities {
  id integer [pk, increment]
  location_id text [not null]
  name text [not null]

  Note: 'Was locations.cities[].name'

  indexes {
    (location_id, name) [unique]
  }
}

Table towns {
  id integer [pk, increment]
  city_id integer [not null]
  name text [not null]

  Note: 'Was locations.cities[].towns[]'

  indexes {
    (city_id, name) [unique]
  }
}

Table users {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  user_name text [not null]
  email text [not null, unique]
  password text [not null]
  avatar text [not null, default: '']
  address text [not null, default: '']
  province text [not null, default: '']
  city text [not null, default: '']
  town text [not null, default: '']
  town_other text [not null, default: '']
  sub_area text [not null, default: '']
  sub_area_other text [not null, default: '']
  phone text [not null, default: '']
  mint_id text [not null, unique]
  role text [not null, default: 'MEMBER']
  // Kept as text, matching Mongoose, on purpose: the app dual-writes these
  // alongside `user_locations.lng`/`lat` and depends on ""/unparseable
  // semantics during the in-progress migration off them. Do not retype
  // without a coordinated app change.
  latitude text [not null, default: '']
  longitude text [not null, default: '']
  device_token text [not null, default: '']
  points integer [not null, default: 0]
  total_collections text [not null, default: '']
  total_waste_collected text [not null, default: '']
  referral_reward_granted boolean [not null, default: false]

  profile_bonus_window_started_at timestamptz
  profile_bonus_granted_at timestamptz [note: 'presence is the payout idempotency key']
  profile_bonus_points integer

  created timestamptz
  first_time_login boolean [not null, default: true]

  email_verified boolean [not null, default: false]
  apple_id text [unique]

  Note: '''
    Mongo collection: users. referrals[] and pickupHistory[] normalized
    out into user_referrals / pickups below. location/structuredAddress/
    locationVerification normalized out into user_locations (1:1) —
    passwordReset/emailVerification normalized out into user_otp_flows.
    See each table's note for why it's split rather than flattened here.
  '''
}

Table user_locations {
  user_id text [pk, note: 'FK to users.id, doubles as PK — enforces strict 1:1, no surrogate id needed']

  // ---- GPS point, from users.location ---------------------------------
  lng numeric [note: 'GeoJSON coordinates[0]']
  lat numeric [note: 'GeoJSON coordinates[1]']
  source location_source
  precision location_precision [note: 'only "building" is usable for routing']
  accuracy_meters numeric
  captured_at timestamptz

  // ---- Registry match, from users.structuredAddress --------------------
  // Left as text matching the name-keyed registry (locations/cities/towns
  // above use synthetic ids, but this column intentionally still matches by
  // display name — see file header).
  structured_city_id text
  structured_area_id text
  structured_block_id text
  structured_area_other text
  structured_block_other text
  structured_house_no text
  structured_street_or_block text

  version integer [not null, default: 0]
  completed_at timestamptz

  // ---- Geocoding QA, from users.locationVerification --------------------
  verification_status location_verification_status
  verification_method text
  verification_geocoded_area_raw text [note: 'NEVER collapse with selected_area_id — labelled geocoder-failure training data']
  verification_geocoded_area_id text
  verification_selected_area_id text
  verification_distance_meters numeric
  verification_checked_at timestamptz
  verification_resolved_by text

  Note: '''
    Split out from users rather than flattened: this was ~20 columns, all
    optional (null until the user completes location capture — gated by
    version/completed_at), always written and read together as one unit by
    that flow. Keeping it on users would mean every basic user query (auth,
    profile lookups, admin lists) carries 20 mostly-NULL columns it doesn't
    need, and "no row" here cleanly means "hasn't set location yet" instead
    of a wall of NULLs on the users row. location + structuredAddress +
    locationVerification are merged into ONE table, not three, since all
    three are 1:1 with the user and always move together in the same
    capture/verification flow — no independent lifecycle or query pattern
    justifies separating them further.
  '''
}

Table user_otp_flows {
  user_id text [not null, note: 'FK to users.id']
  purpose otp_purpose [not null]
  otp_hash text
  expires_at timestamptz
  attempts integer [not null, default: 0]
  last_sent_at timestamptz

  Note: '''
    Was users.passwordReset and users.emailVerification — two Mongoose
    sub-schemas with an IDENTICAL shape (otpHash, expiresAt, attempts,
    lastSentAt), each existing only to serve a different OTP purpose. That's
    the same entity occurring twice, not two entities — merged into one
    table discriminated by `purpose` rather than duplicated as two tables
    (or, worse, kept as two column groups on users, which is what the
    rehearsal-schema-derived draft originally did).

    Mongoose hid these via select:false so the hash never leaks through a
    default query; Postgres has no column-level equivalent for that. Since
    this is now its own table, that guarantee is easy to restore: grant
    the app's normal runtime role no SELECT on this table at all, and read
    otp_hash only through a SECURITY DEFINER function / a role that's only
    assumed for the specific OTP-check code path. Flattening this back onto
    users would remove that option.
  '''

  indexes {
    (user_id, purpose) [pk]
  }
}

Table user_referrals {
  id integer [pk, increment]
  user_id text [not null]
  address text [not null]
  created_at timestamptz

  Note: '''
    Was users.referrals[] (unbounded array, previously multikey-indexed).
    POST /api/users/referrals does an `address IN (...)` style lookup
    across ALL users — index on address, not just (user_id, address).
  '''

  indexes {
    address
    (user_id, address) [unique]
  }
}

Table captains {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  phone text [not null]
  email text [not null, unique]
  password text [not null]
  avatar text [not null, default: '']
  national_id text
  national_id_image text
  role text [not null, default: 'CAPTAIN']
  device_token text [not null, default: '']
  created timestamptz
  email_verified boolean [not null, default: false]
  verification_token text

  Note: 'Mongo collection: captains (unchanged — already flat).'
}

Table logistics {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  phone text [not null]
  email text [not null, unique]
  password text [not null]
  avatar text [not null, default: '']
  role text [not null, default: 'LOGISTIC']
  device_token text [not null, default: '']
  created timestamptz
  email_verified boolean [not null, default: false]
  verification_token text

  Note: 'Mongo collection: logistics (unchanged — already flat).'
}

Table pickups {
  id integer [pk, increment]
  user_id text [not null]
  collection_id text [not null]
  captain_id text [not null]
  occurred_at timestamptz [not null]
  status text [not null]
  comment text [not null, default: '']

  // Address snapshot, flattened (immutable per pickup — a real snapshot,
  // not a live reference, so flat columns are appropriate here, unlike the
  // live user.* location fields above). All nullable: absent on entries
  // created before P0.4a shipped.
  snapshot_address text
  snapshot_province text
  snapshot_city text
  snapshot_town text
  snapshot_town_other text
  snapshot_sub_area text
  snapshot_sub_area_other text
  snapshot_structured_city_id text
  snapshot_structured_area_id text
  snapshot_structured_block_id text
  snapshot_structured_area_other text
  snapshot_structured_block_other text
  snapshot_house_no text
  snapshot_street_or_block text
  snapshot_location_lng numeric
  snapshot_location_lat numeric
  snapshot_location_source location_source
  snapshot_location_precision location_precision
  snapshot_location_accuracy_meters numeric
  snapshot_location_captured_at timestamptz
  snapshot_source snapshot_source [note: '"creation" = honest at-pickup-time snapshot, "migrated" = backfilled']
  snapshot_at timestamptz

  Note: '''
    Was users.pickupHistory[]. Promoting this to its own table is what
    fixes the rehearsal schema's un-remapped-ObjectId bug: collection_id /
    captain_id must be resolved to real integer FKs when the row is built,
    instead of surviving as raw Mongo hex strings inside a jsonb blob.
  '''
}

Table pickup_items {
  id integer [pk, increment]
  pickup_id integer [not null]
  qr_code text [not null, default: '']
  weight numeric [not null, default: 0]

  Note: 'Was pickupHistory[].qrCodesWithWeights[]'
}

Table brands {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  org_id text
  legacy_brand_id text [note: 'self-reference; ETL must insert NULL first, then UPDATE in a second pass through the id map']
  company_name text [not null]
  brand_name text [not null]
  email text [not null, unique]
  logo text
  theme_image text
  category text [not null]
  description text [not null, default: '']
  address text [not null, default: '']
  web_link text [not null]
  app_link text [not null, default: '']
  contact_name text [not null]
  phone text [not null]
  registration_number text [not null, unique]
  domain text [not null, default: '']
  theme_color text [not null, default: '#3B82F6']
  status brand_status [not null, default: 'PENDING']
  role text [not null, default: 'BRAND']
  email_verified boolean [not null, default: false]
  verification_token text
  created_at timestamptz
  updated_at timestamptz

  Note: 'Mongo collection: brands. environmentalStats/environmentalPeriods normalized below.'
}

Table brand_environmental_stats {
  id integer [pk, increment]
  brand_id text [not null]
  is_snapshot boolean [not null, default: false]
  period_start date [note: 'null when is_snapshot']
  period_end date [note: 'null when is_snapshot']
  total_waste_kg numeric [not null]
  co2_avoided_kg numeric [not null]

  Note: '''
    Merges brands.environmentalStats (single snapshot, is_snapshot=true,
    null period bounds) and brands.environmentalPeriods[] (dated buckets,
    is_snapshot=false) into one shape. At most one snapshot row per brand.
  '''

  indexes {
    (brand_id) [name: 'idx_brand_environmental_stats_brand']
  }
}

Table brand_environmental_material_breakdown {
  id integer [pk, increment]
  stat_id integer [not null]
  material text [not null]
  weight_kg numeric [not null]

  Note: 'Was materialBreakdown[] nested inside environmentalStats/environmentalPeriods entries.'
}

Table campaigns {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  start_date text
  end_date text
  is_single_code boolean [not null, default: false]
  discount_percentage text
  status campaign_status [not null, default: 'PENDING']
  brand_id text [not null]
  brand_registration text [not null, default: '']
  description text
  campaign_type text
  target_audience text
  budget numeric
  background_color text
  badge text
  subtitle text
  banner text

  Note: '''
    Mongo collection: campaigns. discountCodes[]/addresses[] normalized
    below. `users` many-to-many carried via campaign_users (unchanged).
    NOT resolved here: this table is structurally a Discount-shaped Deal
    wearing a recycling-programme name (see docs/VOCABULARY.md) — that's a
    domain decision, left for explicit sign-off.
  '''
}

Table campaign_discount_codes {
  id integer [pk, increment]
  campaign_id text [not null]
  code text [not null]
  is_used boolean [not null, default: false]
  used_by_user_id text
  used_at timestamptz

  Note: 'Was campaigns.discountCodes[] (plain string array, no redemption tracking).'

  indexes {
    (campaign_id, code) [unique]
  }
}

Table campaign_addresses {
  id integer [pk, increment]
  campaign_id text [not null]
  province text [not null]
  city text [not null]
  town text [not null]

  Note: 'Was campaigns.addresses[]. Left as free text, not linked via FK into cities/towns — same registry-by-name caveat as users.structured_address.'
}

Table campaign_users {
  id integer [pk, increment]
  campaign_id text [not null]
  user_id text [not null]

  Note: 'Join table for campaigns.users (unchanged from rehearsal schema).'
}

Table collections {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  name text [not null]
  area text [not null]
  city text [not null]
  radius text [not null]
  start_area_lat text [not null]
  start_area_lang text [not null]
  start_date text [not null]
  status collection_status [not null, default: 'PENDING']

  Note: '''
    Mongo collection: collections (unchanged structurally from rehearsal
    schema — text-typed radius/lat/lng/date are flagged type debt, not
    fixed here; see file header). `users`/`captainsWithDates` many-to-many
    carried via collection_users / collection_captains.
  '''
}

Table collection_users {
  id integer [pk, increment]
  collection_id text [not null]
  user_id text [not null]

  Note: 'Join table for collections.users (unchanged from rehearsal schema).'
}

Table collection_captains {
  id integer [pk, increment]
  collection_id text [not null]
  captain_id text [not null]
  date text [not null]

  Note: 'Join table for collections.captainsWithDates (unchanged from rehearsal schema).'
}

Table deals {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  brand_id text [not null]
  title text [not null]
  description text [not null, default: '']
  discount_percentage numeric
  discount_amount numeric
  start_date text
  end_date text
  max_uses integer
  current_uses integer [not null, default: 0]
  minimum_purchase numeric
  status deal_status [not null, default: 'pending']
  created_at timestamptz
  updated_at timestamptz

  Note: '''
    Mongo collection: deals. codes[] normalized into deal_codes below;
    promo_code dropped as a stored column (was a duplicate of codes[0] —
    expose "the primary code" via a view over deal_codes instead of
    storing it twice). `users`/`claims` many-to-many carried via
    deal_users / deal_claims.
  '''
}

Table deal_codes {
  id integer [pk, increment]
  deal_id text [not null]
  code text [not null]
  is_used boolean [not null, default: false]

  Note: 'Was deals.codes[] (plain string array).'

  indexes {
    (deal_id, code) [unique]
  }
}

Table deal_users {
  id integer [pk, increment]
  deal_id text [not null]
  user_id text [not null]

  Note: 'Join table for deals.users (unchanged from rehearsal schema).'
}

Table deal_claims {
  id integer [pk, increment]
  deal_id text [not null]
  user_id text [not null]
  code text [not null]
  claimed_at timestamptz

  Note: 'Join table for deals.claims. code now FKs into deal_codes so a claim cannot reference a code that was never issued.'
}

Table brandusers {
  id text [pk, note: 'Mongo ObjectId, carried across verbatim. NOT a surrogate: it is the id every JWT, every already-issued API response and every persisted client key already contains, so the cutover changes no identifier a client has ever seen. New rows mint one with mongoose Types.ObjectId() — generation is client-side, so this keeps working with Mongo decommissioned.']
  org_id text [not null]
  email text [not null, unique]
  password_hash text [not null]
  org_role text [not null]
  created_at timestamptz
  updated_at timestamptz

  Note: 'Mongo collection: brandusers. moduleAccess[] normalized below.'
}

Table brand_user_module_access {
  id integer [pk, increment]
  brand_user_id text [not null]
  module text [not null]
  permission text [not null]

  Note: 'Was brandusers.moduleAccess[].{module, permissions[]} — flattened to one row per (module, permission) pair.'

  indexes {
    (brand_user_id, module, permission) [unique]
  }
}

Ref: cities.location_id > locations.id
Ref: towns.city_id > cities.id

Ref: user_locations.user_id > users.id
Ref: user_otp_flows.user_id > users.id

Ref: user_referrals.user_id > users.id

Ref: pickups.user_id > users.id
Ref: pickups.collection_id > collections.id
Ref: pickups.captain_id > captains.id
Ref: pickup_items.pickup_id > pickups.id

Ref: brands.org_id > organizations.id
Ref: brands.legacy_brand_id > brands.id
Ref: brand_environmental_stats.brand_id > brands.id
Ref: brand_environmental_material_breakdown.stat_id > brand_environmental_stats.id

Ref: campaigns.brand_id > brands.id
Ref: campaign_discount_codes.campaign_id > campaigns.id
Ref: campaign_discount_codes.used_by_user_id > users.id
Ref: campaign_addresses.campaign_id > campaigns.id
Ref: campaign_users.campaign_id > campaigns.id
Ref: campaign_users.user_id > users.id

Ref: collection_users.collection_id > collections.id
Ref: collection_users.user_id > users.id
Ref: collection_captains.collection_id > collections.id
Ref: collection_captains.captain_id > captains.id

Ref: deals.brand_id > brands.id
Ref: deal_codes.deal_id > deals.id
Ref: deal_users.deal_id > deals.id
Ref: deal_users.user_id > users.id
Ref: deal_claims.deal_id > deals.id
Ref: deal_claims.user_id > users.id
Ref: deal_claims.(deal_id, code) > deal_codes.(deal_id, code)

Ref: organization_module_subscriptions.org_id > organizations.id
Ref: brandusers.org_id > organizations.id
Ref: brand_user_module_access.brand_user_id > brandusers.id
