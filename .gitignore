.next
tsconfig.tsbuildinfo

# Generated by `next dev` / `next build`. Its own body says "This file should
# not be edited", and it references .next/dev/types/routes.d.ts, which only
# exists after a dev server has run — committing it breaks `tsc` on a fresh
# clone.
next-env.d.ts
graphify-out/

# Local agent/tooling scratch. None of this is part of the build, and it churns
# constantly — kept on disk, out of the repo.
.claude/
.impeccable/
.superpowers/
.specify/
.vscode/

# docs/ is deliberately NOT ignored: docs/VOCABULARY.md is the canonical naming
# reference for this repo, BrandHub and the app, so it has to stay in git.

# scripts/out/ holds run artifacts from location-backfill-audit.js (the audit
# report, and transient .partial.ndjson / checkpoint files for a resumed
# run) — real (hashed, but per-run) data, never committed.
scripts/out/
